# Forzar LF en todos los archivos de texto
* text=auto eol=lf

# Archivos Python siempre con LF
*.py text eol=lf

# Archivos de configuración y scripts
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Frontend: JS, CSS, HTML siempre con LF
*.js text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf

# Archivos JSON, YAML, Markdown también con LF
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf

# Evitar que Git toque binarios
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
